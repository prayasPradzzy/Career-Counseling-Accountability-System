[TEMPLATE]
# ================================
# Server environment variables
# Copy to `.env` and fill in real values.
# See .freebuff/run.md and the deployment guide for where each comes from.
# ================================

# HTTP port the Express server listens on (Render sets this automatically)
PORT=5000

# development | production
NODE_ENV=development

# MongoDB Atlas connection string (Drivers → connection string in Atlas)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>

# Long random string used to sign JWTs — generate one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# How long JWTs stay valid, e.g. 7d, 1h
JWT_EXPIRES_IN=7d

# The frontend origin this server allows (CORS) and uses in redirect links.
# Local dev: http://localhost:3000   Production: https://<your-app>.vercel.app
# Multiple origins are supported as a comma-separated list.
CLIENT_URL=http://localhost:3000

# ── AI / LLM (optional — powers the interview question generator) ──────────
# If no key is configured, aiService falls back to a deterministic local
# generator so the pipeline still works (AIRequestLog records source: "fallback").

# Provider: "openai" (default), "groq", or "gemini"
LLM_PROVIDER=openai

# OpenAI-compatible API key (custom base URLs/proxies supported via OPENAI_BASE_URL)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Groq (OpenAI-compatible endpoint, free tier — no card needed).
# Sign up at console.groq.com → API Keys. Free tier ≈ 30 req/min org-wide.
# Set LLM_PROVIDER=groq to route through Groq. The same account's Whisper
# endpoint can later serve Phase 3's Hinglish transcription.
GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Google Generative Language API key (used when LLM_PROVIDER=gemini)
GEMINI_API_KEY=

# Model identifier, e.g. gpt-4o-mini, llama-3.3-70b-versatile, or gemini-1.5-flash
LLM_MODEL=gpt-4o-mini
